---
import '../assets/app.css';
import {siteConfig, profiles} from '../data/site';
import {projects} from '../data/projects';

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  image?: string;
}

const {title = siteConfig.title, description = siteConfig.description, pathname = '/', image = siteConfig.image} = Astro.props;

const siteUrl = Astro.site?.href ?? siteConfig.url;
const canonicalUrl = new URL(pathname, siteUrl).href;
const socialImageUrl = new URL(image, siteUrl).href;
const profileList = Object.values(profiles);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteConfig.url}/#person`,
      name: siteConfig.name,
      url: siteConfig.url,
      image: socialImageUrl,
      description,
      jobTitle: ['Frontend Lead', siteConfig.role],
      nationality: 'Danish',
      homeLocation: {
        '@type': 'Country',
        name: siteConfig.location,
      },
      worksFor: {
        '@id': `${siteConfig.url}/#organization`,
      },
      alumniOf: {
        '@id': `${siteConfig.url}/#education`,
      },
      knowsAbout: siteConfig.knowsAbout,
      knowsLanguage: ['English', 'Danish'],
      sameAs: profileList.map((profile) => profile.href),
      mainEntityOfPage: {
        '@id': `${canonicalUrl}#webpage`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteConfig.url}/#organization`,
      name: siteConfig.employer,
    },
    {
      '@type': 'CollegeOrUniversity',
      '@id': `${siteConfig.url}/#education`,
      name: siteConfig.education,
    },
    {
      '@type': 'ImageObject',
      '@id': `${siteConfig.url}/#primaryimage`,
      url: socialImageUrl,
      contentUrl: socialImageUrl,
      width: 1200,
      height: 630,
      caption: `${siteConfig.name} portfolio social preview`,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.url}/#website`,
      url: siteConfig.url,
      name: siteConfig.name,
      description: siteConfig.description,
      inLanguage: siteConfig.language,
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: {
        '@id': `${siteConfig.url}/#website`,
      },
      about: {
        '@id': `${siteConfig.url}/#person`,
      },
      mainEntity: {
        '@id': `${siteConfig.url}/#person`,
      },
      primaryImageOfPage: {
        '@id': `${siteConfig.url}/#primaryimage`,
      },
      inLanguage: siteConfig.language,
    },
    {
      '@type': 'ItemList',
      '@id': `${siteConfig.url}/#featured-projects`,
      name: 'Featured projects by Magnus Granno',
      itemListElement: projects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: project.title,
        url: project.url,
        description: project.description,
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={siteConfig.keywords.join(', ')} />
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {profileList.map((profile) => <link rel="me" href={profile.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Magnus Granno, fullstack developer with a frontend focus, based in Denmark" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@magnus_granno" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Magnus Granno, fullstack developer with a frontend focus, based in Denmark" />
    <meta name="twitter:creator" content="@magnus_granno" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="bg-ground text-ink font-sans antialiased">
    <header class="page-shell flex h-18 items-center justify-between text-base font-medium lg:h-26 lg:text-[17px]">
      <a class="quiet tracking-[-0.01em]" href="#top">{siteConfig.name}</a>
      <nav aria-label="Sections" class="flex gap-5 lg:gap-10">
        <a class="quiet" href="#projects">Projects</a>
        <a class="quiet" href="#work">Work</a>
        <a class="quiet max-md:hidden" href="#about">About</a>
        <a class="quiet" href={`mailto:${siteConfig.email}`}>Email</a>
      </nav>
    </header>

    <main class="page-shell">
      <slot />
    </main>

    <footer class="page-shell pb-10 lg:pb-16">
      <div class="flex flex-col gap-10 border-t border-rule pt-8 lg:gap-16 lg:pt-12">
        <p class="max-w-[900px] text-3xl/[1.15] font-medium tracking-[-0.025em] lg:text-[44px] lg:leading-[1.12]">
          Have a project in mind? Write to <a class="wrap-anywhere" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </p>
        <div
          class="flex flex-col-reverse gap-4 text-[15px] text-muted md:flex-row md:items-center md:justify-between lg:text-base">
          <p>&copy; {new Date().getFullYear()} {siteConfig.name}</p>
          <ul class="flex flex-wrap gap-x-6 gap-y-2 lg:gap-x-8" aria-label="Profiles">
            {
              profileList.map(({label, href}) => (
                <li>
                  <a class="quiet" href={href} target="_blank" rel="me noopener noreferrer">
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
