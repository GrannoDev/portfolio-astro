---
import type {Change} from '../data/work';

interface Props {
  label: Change['kind'] | 'Shipped' | 'Exploring';
}

const {label} = Astro.props;
---

<div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
  <span class="chip shrink-0">{label}</span>
  <div class="max-w-[62ch] min-w-0 flex-[1_1_320px] text-body">
    <slot />
  </div>
</div>
