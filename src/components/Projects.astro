---
import ProjectCard from './ProjectCard.astro';
import {projects} from '../data/projects';
---

<section id="projects" aria-labelledby="projects-heading" class="page-section flex flex-col">
  <div class="section-grid items-baseline gap-1.5 border-b border-rule pb-4 md:gap-6 md:pb-5">
    <h2 id="projects-heading" class="text-[17px] font-semibold tracking-[-0.01em] md:text-lg/normal">Projects</h2>
    <p class="text-base text-muted md:text-lg/normal">Five things I have built or help build.</p>
  </div>

  {projects.map((project) => <ProjectCard {...project} />)}
</section>
