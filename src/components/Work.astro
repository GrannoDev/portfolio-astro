---
import {roles, workSummary} from '../data/work';
---

<section id="work" aria-labelledby="work-heading" class="page-section flex flex-col">
  <div class="section-grid gap-1.5 border-b border-rule pb-4 md:items-baseline md:gap-6 md:pb-5">
    <h2 id="work-heading" class="text-[17px] font-semibold lg:text-lg/normal lg:tracking-[-0.01em]">Work</h2>
    <p class="text-base text-muted lg:text-lg/normal">{workSummary}</p>
  </div>

  <ol>
    {
      roles.map((role) => (
        <li class="section-grid items-start gap-2 border-b border-rule py-6 md:gap-6 lg:py-9">
          <p class="text-[15px] text-muted tabular-nums md:pt-1 lg:text-lg/normal">{role.date}</p>
          <div class="flex flex-col gap-2 lg:gap-2.5">
            <h3 class="text-[21px] leading-[1.2] font-medium tracking-[-0.015em] lg:text-2xl/[1.2]">{role.title}</h3>
            <p class="max-w-[680px] text-base text-muted lg:text-lg/normal">{role.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
