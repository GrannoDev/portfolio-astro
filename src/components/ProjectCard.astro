---
import {Image} from 'astro:assets';
import type {Project} from '../data/projects';

type Props = Project;

const {type, title, description, stack, url, linkLabel, image, imageAlt} = Astro.props;
---

<article
  class="section-grid gap-3 border-b border-rule py-7 md:gap-6 lg:grid-cols-[200px_minmax(0,1fr)_300px] lg:items-start lg:py-10">
  <p class="pt-2 text-sm/normal text-muted md:pt-1.5 md:text-base">{type}</p>

  <div class="flex flex-col gap-3 md:gap-3.5 lg:pr-10">
    <h3 class="text-2xl/[1.15] font-medium tracking-[-0.02em] md:text-[28px]">{title}</h3>
    <p class="text-base text-muted md:max-w-[560px] md:text-lg/normal">{description}</p>
    <p class="text-sm/normal text-muted md:text-[15px]">{stack}</p>
    <a href={url} target="_blank" rel="noopener noreferrer" class="self-start text-[15px] font-medium md:text-base">
      {linkLabel}
    </a>
  </div>

  <Image
    src={image}
    alt={imageAlt}
    width={600}
    class="order-first aspect-[500/274] w-full rounded-md bg-well object-cover md:order-none md:col-start-2 md:h-41 md:w-75 md:aspect-auto lg:col-start-3"
  />
</article>
